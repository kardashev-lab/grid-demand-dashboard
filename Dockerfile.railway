# Minimal single-container deploy for Railway: the Next.js dashboard now owns both
# the API (Route Handlers, same contract the old Express aggregator served) and the
# in-process kardashev-data polling (instrumentation.ts -> lib/poller.ts). No Redis,
# no Postgres, no fetcher fleet -- see services/aggregator + docker-compose.yml for
# the actual distributed submission this was built to demonstrate.

FROM node:20-alpine AS deps
WORKDIR /app
COPY services/dashboard/package.json services/dashboard/package-lock.json* ./
RUN npm ci

FROM node:20-alpine AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY services/dashboard/ .
RUN npm run build

FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production

COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
COPY --from=builder /app/public ./public

EXPOSE 3000
CMD ["node", "server.js"]
