# Register for a free API key at https://api.eia.gov/register/
EIA_API_KEY=

# how often fetchers poll EIA (ms). EIA publishes hourly, so 1200000 (20 min)
# is a reasonable balance: catches the new value within ~20 min of publish
# while staying well under the rate limit. Drop to 60000 (1 min) only if you
# want the chaos/recovery experiment to see frequent stream activity.
POLL_INTERVAL=1200000

# --- Optional: Railway single-container deploy (see README)
# DATABASE_URL=postgresql://...   # Railway Postgres plugin → persisted hourly rows + hydrate on boot
# STATIC_DIR=/app/public          # set automatically in Dockerfile.railway
# SERVE_STATIC=0                  # set to serve API only (no SPA)
# BACKFILL_HOURS=48
# EIA_STAGGER_MS=300              # delay between BAs to reduce EIA 429s
