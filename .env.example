# Base URL of the kardashev-data API that fetchers/pollers read demand from.
# Defaults to the public instance if unset.
KARDASHEV_API_URL=https://data.kardashevlabs.org

# How often fetchers poll (ms). Source data updates every ~5 min; 1200000 (20 min)
# is a reasonable default for the distributed stack. Drop to 60000 (1 min) only if
# you want the chaos/recovery experiment to see frequent stream activity.
POLL_INTERVAL=1200000

# --- Optional: Railway single-container deploy (see README)
# BACKFILL_HOURS=48

# --- Optional: distributed/Compose local dev only
# Set to point the dashboard at a separately-running aggregator instead of polling
# kardashev-data itself (this is what docker-compose.yml sets automatically).
# AGGREGATOR_API_URL=http://localhost:3001
