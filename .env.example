# Base URL of the kardashev-data API the dashboard polls demand from.
# Defaults to the public instance if unset.
KARDASHEV_API_URL=https://data.kardashevlabs.org

# How often the dashboard polls (ms). Source data updates every ~5 min.
POLL_INTERVAL=300000

# How many hours of history to backfill on boot.
BACKFILL_HOURS=48
